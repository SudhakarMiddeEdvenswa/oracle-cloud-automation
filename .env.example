# ============================================================================
# Oracle Cloud Automation Platform — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env      (Git Bash / Linux / macOS)
#   copy .env.example .env    (Windows CMD)
# The ".env" file is git-ignored and must NEVER be committed.
#
# Everything here is a *default*. The web UI asks for the application URL, the
# user name and the password on every run, so a shared server does not need
# credentials on disk at all — leave those three blank in that case.
# ============================================================================

# --- Default instance details (prefilled in the UI, used by the CLI) --------
ORACLE_BASE_URL=https://your-pod.fa.ocs.oraclecloud.com
ORACLE_USERNAME=your_username_here
ORACLE_PASSWORD=your_password_here

# --- AI agent ---------------------------------------------------------------
# Required for AI-driven flows, for locator self-healing on coded flows, and
# for the "ai:" rules in a verification file. Without it the platform still
# runs every step that has a deterministic implementation.
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model the agent drives the browser with.
AGENT_MODEL=claude-opus-5
# Reasoning effort: low | medium | high | xhigh | max
AGENT_EFFORT=high
# Safety valve: the most tool-calling turns the agent may spend on one step.
AGENT_MAX_ITERATIONS=40

# --- Platform server --------------------------------------------------------
PLATFORM_PORT=4000
PLATFORM_HOST=127.0.0.1

# --- Runtime / execution defaults -------------------------------------------
# Run the browser with a visible UI (false) or headless (true).
HEADLESS=false
# Browser to use: chromium | firefox | webkit
BROWSER=chromium
# Default timeout for actions, navigations and the post-login home-page check.
DEFAULT_TIMEOUT=60000
# Slow down each Playwright operation by N ms (useful for debugging). 0 = off.
SLOW_MO=0

# --- Optional business configuration ----------------------------------------
# Fallback Procurement Business Unit when a data file leaves the column blank.
PROCUREMENT_BUSINESS_UNIT=
