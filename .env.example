# ============================================================================
# Oracle Cloud SaaS - Supplier Automation - Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env      (Git Bash / Linux / macOS)
#   copy .env.example .env    (Windows CMD)
# The ".env" file is git-ignored and must NEVER be committed.
# ============================================================================

# --- Application URL --------------------------------------------------------
# Base URL of the Oracle Cloud SaaS (Fusion) environment.
ORACLE_BASE_URL=https://your-pod.fa.ocs.oraclecloud.com

# --- Login credentials (KEEP SECRET) ----------------------------------------
ORACLE_USERNAME=your_username_here
ORACLE_PASSWORD=your_password_here

# --- Optional business configuration ----------------------------------------
# Procurement Business Unit used for Site Assignments (step 15).
PROCUREMENT_BUSINESS_UNIT=

# --- Runtime / execution tuning ---------------------------------------------
# Run browser with a visible UI (true) or headless (false).
HEADLESS=false
# Browser to use: chromium | firefox | webkit
BROWSER=chromium
# Global default timeout for actions/navigations in milliseconds.
DEFAULT_TIMEOUT=60000
# Slow down each Playwright operation by N ms (useful for debugging). 0 = off.
SLOW_MO=0
