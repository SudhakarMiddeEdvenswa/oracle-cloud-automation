{
  "name": "oracle-cloud-automation-platform",
  "version": "0.2.0",
  "description": "Generic AI-assisted UI automation platform: registry-driven business flows, CSV test data, a web UI, and HTML/CSV/XLSX reporting.",
  "type": "module",
  "scripts": {
    "ui": "npm run ui:build && node platform/server/index.js",
    "ui:server": "node platform/server/index.js",
    "ui:build": "vite build --config platform/web/vite.config.js",
    "ui:dev": "concurrently -n api,web -c blue,green \"node platform/server/index.js\" \"vite --config platform/web/vite.config.js\"",
    "run": "node platform/cli.js",
    "test": "playwright test",
    "test:supplier": "playwright test tests/createSupplier.spec.js",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "keywords": [
    "playwright",
    "oracle-cloud",
    "oracle-fusion",
    "test-automation",
    "ai-agent",
    "data-driven",
    "procurement",
    "payables"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "papaparse": "^5.7.0"
  }
}
